# ============================================
# 88code Reset 多账号配置模板
# 适用于 Windows Docker Compose 部署
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 替换下面的 API Keys 为你的实际值
# 3. 根据需要调整其他配置
# 4. 运行 start.bat 启动服务
# ============================================

# 📌 多账号配置（必须配置）
# 替换为你的实际 API Keys，用英文逗号分隔，不要有空格
# 示例：API_KEYS=sk-abc123,sk-def456,sk-ghi789
API_KEYS=sk-your-first-key-here,sk-your-second-key-here,sk-your-third-key-here

# 🌍 时区配置
# 影响定时任务的执行时间
# 常用时区：Asia/Shanghai, Asia/Hong_Kong, UTC
TIMEZONE=Asia/Shanghai

# ============================================
# 💰 额度判断配置（可选）
# ============================================
# 两种模式二选一：
# 1. 上限模式（推荐）：当额度 > 上限时跳过18:50重置
# 2. 下限模式：当额度 < 下限时才执行18:50重置

# 上限模式配置（默认启用）
# 当额度 > 83% 时跳过18:50重置，保留重置机会到23:55
CREDIT_THRESHOLD_MAX=83

# 下限模式配置（默认禁用）
# 取消下面的注释启用下限模式，同时注释掉上限配置
# 当额度 < 50% 时才执行18:50重置
# CREDIT_THRESHOLD_MIN=50

# ============================================
# ⏰ 重置时间配置
# ============================================
# 是否启用18:50重置（默认关闭）
# 可选值：true, false, 1, 0, yes, no, on, off, enabled, disabled
# 
# false = 只在23:55重置（保守策略，推荐）
# true  = 在18:50和23:55都重置（激进策略）
ENABLE_FIRST_RESET=false

# ============================================
# 🎯 目标套餐配置（可选）
# ============================================
# 留空 = 处理所有 MONTHLY 套餐（推荐）
# 指定套餐 = 只处理指定的套餐名称，多个用逗号分隔
# 
# 示例：
# PLANS=FREE          # 只处理 FREE 套餐
# PLANS=FREE,PRO      # 处理 FREE 和 PRO 套餐
# PLANS=              # 处理所有 MONTHLY 套餐
PLANS=

# ============================================
# 配置示例
# ============================================
# 
# 示例1：保守策略（推荐新手）
# API_KEYS=sk-key1,sk-key2,sk-key3
# TIMEZONE=Asia/Shanghai
# CREDIT_THRESHOLD_MAX=83
# ENABLE_FIRST_RESET=false
# PLANS=
#
# 示例2：激进策略
# API_KEYS=sk-key1,sk-key2,sk-key3
# TIMEZONE=Asia/Shanghai
# CREDIT_THRESHOLD_MIN=50
# ENABLE_FIRST_RESET=true
# PLANS=
#
# 示例3：精准控制（仅特定套餐）
# API_KEYS=sk-key1,sk-key2,sk-key3
# TIMEZONE=Asia/Shanghai
# CREDIT_THRESHOLD_MAX=75
# ENABLE_FIRST_RESET=true
# PLANS=FREE,PRO
#
# ============================================